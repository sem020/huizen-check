# Kopieer naar .env en vul in waar nodig.
# Zonder Mollie-key werkt alles in MOCK-modus (geen account nodig).

PORT=3000
PUBLIC_URL=http://localhost:3000
# Optioneel: schrijfbare map (default ./data, fallback /tmp/pandloket-data)
# DATA_DIR=
# mock | test | live
# mock  = gesimuleerde betaling (standaard, geen account)
# test  = Mollie testmodus (test_xxx key)
# live  = echte betalingen (live_xxx key)
PAYMENT_MODE=mock

# Mollie — alleen nodig bij PAYMENT_MODE=test of live
MOLLIE_API_KEY=

# Prijs in eurocent (495 = € 4,95)
PRICE_CENTS=495
PRODUCT_NAME=Pandloket PDF

# E-mail — leeg = mock (logt naar terminal, geen echte mail)
# RESEND_API_KEY=re_xxx
MAIL_FROM=Pandloket <noreply@pandloket.nl>

# EP-Online energielabel (RVO) — verplicht voor live labels
# Aanvragen: https://apikey.ep-online.nl
EP_ONLINE_API_KEY=
